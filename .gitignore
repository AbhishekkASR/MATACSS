# Root-level project ignores

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Databases and local runtime files
*.db
*.sqlite3
*.sqlite
.env
.env.*
!.env.example
!.env.production.example

# Node / frontend
node_modules/
.next/
out/
coverage/
.npm/

# Build artifacts
dist/
build/
*.tsbuildinfo

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.log

# Secrets / certificates
*.pem
*.key
*.crt

# Raw question bank datasets (128 MB+ -- use scripts/download_livecodebench.py)
# Git LFS is not required; obtain datasets via the download script.
data/question_bank/**/*.jsonl
data/question_bank/**/*.json
data/question_bank/livecodebench/LiveCodeBench.tmp
# Keep directory structure in Git
!data/question_bank/**/.gitkeep
