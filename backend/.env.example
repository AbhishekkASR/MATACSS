# Application
MATACSS_APP_TITLE=MATACSS Backend

# Local PostgreSQL Compose settings. Replace the placeholder password locally.
POSTGRES_DB=matacss
POSTGRES_USER=matacss_user
POSTGRES_PASSWORD=change_me

# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://matacss_user:change_me@localhost:5432/matacss
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication settings. Set a strong secret in the local environment.
MATACSS_JWT_SECRET=change-me-in-your-env
MATACSS_JWT_ALGORITHM=HS256
MATACSS_JWT_EXPIRE_MINUTES=60

# Backend-only OpenAI configuration. Set OPENAI_API_KEY in your local environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Optional Azure OpenAI configuration. When set, all three credentials/deployment
# values are required and Azure is used instead of the direct OpenAI endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=30
