# Copy to backend/.env and change the placeholder database password before use.
APP_ENV=development
DEBUG=false
MATACSS_APP_TITLE=MATACSS Backend
MATACSS_API_HOST=0.0.0.0
MATACSS_API_PORT=8000
MATACSS_LOG_LEVEL=INFO

# PostgreSQL credentials. Keep POSTGRES_PASSWORD and DATABASE_URL in sync.
POSTGRES_DB=matacss
POSTGRES_USER=matacss_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://matacss_user:change_me@postgres:5432/matacss
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Trusted browser origins used by backend CORS.
MATACSS_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Authentication. Replace this placeholder outside local-only development.
MATACSS_JWT_SECRET=change-me-in-your-env
MATACSS_JWT_ALGORITHM=HS256
MATACSS_JWT_EXPIRE_MINUTES=60

# Queue worker settings.
MATACSS_WORKER_POLL_INTERVAL_SECONDS=5
MATACSS_WORKER_BATCH_SIZE=10
MATACSS_WORKER_MAX_CONCURRENCY=1
MATACSS_WORKER_MAX_RETRIES=3

# Docker SDK connects only to a dedicated TLS-protected execution daemon.
# Provision ca.pem, cert.pem, and key.pem in this directory; never commit them.
MATACSS_DOCKER_HOST=tcp://docker-executor.example.internal:2376
MATACSS_DOCKER_CERTS_DIR=./docker-client-certs
MATACSS_SANDBOX_PYTHON_IMAGE=python:3.12-alpine
MATACSS_SANDBOX_CPP_IMAGE=gcc:14-bookworm
MATACSS_SANDBOX_JAVA_IMAGE=eclipse-temurin:21-jdk
MATACSS_SANDBOX_TIMEOUT_SECONDS=5
MATACSS_SANDBOX_MEMORY_LIMIT=128m
MATACSS_SANDBOX_CPU_LIMIT=0.5
MATACSS_SANDBOX_PIDS_LIMIT=64
MATACSS_SANDBOX_OUTPUT_LIMIT_BYTES=65536

# Backend-only LLM credentials. Leave unset unless using that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=30

# Local host port bindings. Put production deployments behind a TLS reverse proxy.
POSTGRES_PUBLISHED_PORT=5432
MATACSS_API_BIND_ADDRESS=127.0.0.1
MATACSS_API_PUBLISHED_PORT=8000
MATACSS_FRONTEND_BIND_ADDRESS=127.0.0.1
MATACSS_FRONTEND_PUBLISHED_PORT=3000

# This value is compiled into the browser bundle; it is public, never a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
