# Production reference only. Copy to backend/.env and supply actual values
# through a secret manager or protected deployment environment. Do not commit
# backend/.env with real values.
APP_ENV=production
DEBUG=false
MATACSS_APP_TITLE=MATACSS Backend
MATACSS_API_HOST=0.0.0.0
MATACSS_API_PORT=8000
MATACSS_LOG_LEVEL=INFO

POSTGRES_DB=matacss
POSTGRES_USER=matacss_user
POSTGRES_PASSWORD=replace_with_a_strong_url_safe_password
DATABASE_URL=postgresql+asyncpg://matacss_user:replace_with_a_strong_url_safe_password@postgres:5432/matacss
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

MATACSS_FRONTEND_ORIGINS=https://app.example.com
MATACSS_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
MATACSS_JWT_ALGORITHM=HS256
MATACSS_JWT_EXPIRE_MINUTES=60

MATACSS_WORKER_POLL_INTERVAL_SECONDS=5
MATACSS_WORKER_BATCH_SIZE=10
MATACSS_WORKER_MAX_CONCURRENCY=1
MATACSS_WORKER_MAX_RETRIES=3

# Use an isolated execution host, not the application host's Docker daemon.
# Require mutually authenticated TLS and firewall access to the API/worker.
MATACSS_DOCKER_HOST=tcp://dedicated-executor.example.com:2376
MATACSS_DOCKER_CERTS_DIR=/etc/matacss/docker-client-certs
MATACSS_SANDBOX_PYTHON_IMAGE=python:3.12-alpine
MATACSS_SANDBOX_CPP_IMAGE=gcc:14-bookworm
MATACSS_SANDBOX_JAVA_IMAGE=eclipse-temurin:21-jdk
MATACSS_SANDBOX_TIMEOUT_SECONDS=5
MATACSS_SANDBOX_MEMORY_LIMIT=128m
MATACSS_SANDBOX_CPU_LIMIT=0.5
MATACSS_SANDBOX_PIDS_LIMIT=64
MATACSS_SANDBOX_OUTPUT_LIMIT_BYTES=65536

# Backend-only LLM configuration. Inject provider API keys as secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=30

# Host bind ports; terminate TLS at the reverse proxy.
POSTGRES_PUBLISHED_PORT=5432
MATACSS_API_BIND_ADDRESS=127.0.0.1
MATACSS_API_PUBLISHED_PORT=8000
MATACSS_FRONTEND_BIND_ADDRESS=127.0.0.1
MATACSS_FRONTEND_PUBLISHED_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
